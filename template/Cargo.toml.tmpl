[package]
name = "__NAME__"
version = "0.0.0"
edition = "2021"

[features]
# One crate, one feature per platform: `dx serve --platform web|desktop|ios|android`.
default = ["web"]
web = ["dioxus/web"]
desktop = ["dioxus/desktop"]
mobile = ["dioxus/mobile"]
# Optional blocks, nothing imposed: local DB and sync.
store = ["biorcrux/store"]
store-sqlite = ["biorcrux/store-sqlite"]
sync = ["biorcrux/sync"]

[dependencies]
# Same Dioxus source as biorcrux (`main`, owner decision 2026-11-16): two copies would not interoperate.
dioxus = { git = "https://github.com/DioxusLabs/dioxus", branch = "main" }
biorcrux = { git = "https://github.com/grosjeanbaptiste/biorcrux", tag = "__TAG__" }

[build-dependencies]
# Resolves the app icon: the repo's own, else the BIORCRUX one.
biorcrux = { git = "https://github.com/grosjeanbaptiste/biorcrux", tag = "__TAG__", default-features = false, features = ["design"] }

[dev-dependencies]
dioxus-ssr = { git = "https://github.com/DioxusLabs/dioxus", branch = "main" }

[lints.rust]
unsafe_code = "forbid"
warnings = "deny"

[lints.clippy]
all = { level = "deny", priority = -1 }
